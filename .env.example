# KèoLab Environment Configuration

ENVIRONMENT=development
DATABASE_URL=sqlite:///./keolab.db

# Optional External API Keys (Graceful fallback to embedded seed data & football-data.co.uk CSVs)
FOOTBALL_DATA_ORG_KEY=
THE_ODDS_API_KEY=

# Quantitative Hyperparameters
MIN_EDGE=0.025
MIN_EV=0.030
MAX_MARKET_DIVERGENCE=0.12
KELLY_FRACTION=0.25
MAX_VIRTUAL_STAKE_PCT=0.02

# Frontend URL for CORS
NEXT_PUBLIC_API_URL=http://localhost:8000/api
